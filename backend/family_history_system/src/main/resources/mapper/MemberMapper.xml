<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.family_history_system.mapper.MemberMapper">

    <!-- 按家族表ID删除其下全部成员 -->
    <delete id="deleteByFamilyTableId">
        delete from `system`.member where family_table_id = #{familyTableId}
    </delete>

</mapper>
